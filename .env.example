GEMINI_API_KEY=

# Final log narrator: AUTO = local first, Gemini fallback
NARRATOR_PROVIDER=AUTO
LOCAL_NARRATOR_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_NARRATOR_MODEL=local-narrator
NARRATOR_GEMINI_FALLBACK=true
LOCAL_NARRATOR_TEMPERATURE=0.72
LOCAL_NARRATOR_TOP_P=0.92
LOCAL_NARRATOR_MAX_TOKENS=2400
LOCAL_NARRATOR_REPEAT_PENALTY=1.08
LOCAL_NARRATOR_RETRIES=2
LOCAL_NARRATOR_TIMEOUT_MS=120000

# Optional GitHub/raw update manifest URL. Check-only in web runtime; packaged launcher will apply updates.
FANTASYAC_UPDATE_MANIFEST_URL=

# Native app update manifest (GitHub raw/release URL)
VITE_FANTASYAC_UPDATE_MANIFEST_URL=
